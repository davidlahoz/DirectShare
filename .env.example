# DirectSend configuration. Copy to .env and adjust. All values are optional.

# --- Cloudflare Tunnel (default deployment) ----------------------------------
# Your public URL as served by Cloudflare. Only pages from this origin may open
# signaling WebSockets.
# ALLOWED_ORIGINS=https://send.example.com
# Host port on 127.0.0.1 that cloudflared forwards to (docker-compose.yml).
HOST_PORT=8080

# --- Network -----------------------------------------------------------------
# Port and interface the Node server listens on.
PORT=8080
HOST=0.0.0.0
# Serve HTTPS/WSS directly from Node (alternative to a reverse proxy).
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem
# Honor CF-Connecting-IP / X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
# Enable ONLY when the port is reachable solely through a trusted proxy
# (docker-compose.yml defaults to true because it binds to 127.0.0.1).
TRUST_PROXY=true
# Comma-separated origins allowed to open signaling WebSockets.
# Empty = only the same host that served the page.
# ALLOWED_ORIGINS=https://send.example.com

# --- WebRTC ------------------------------------------------------------------
# STUN servers used to discover public addresses. TURN relays are refused on
# purpose: DirectSend only uses direct peer-to-peer connections.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Seconds to wait for a direct connection before reporting failure.
CONNECT_TIMEOUT_SECONDS=30

# --- Rooms -------------------------------------------------------------------
# How long a sharing link stays valid (seconds). Transfers already running
# peer-to-peer continue after expiry; new receivers cannot join.
ROOM_TTL_SECONDS=7200
# Receivers that may join one sharing link.
MAX_RECEIVERS_PER_ROOM=10
# Receivers that connect/transfer at the same time; the rest are queued.
MAX_CONCURRENT_TRANSFERS=3
# How long a disconnected sender or receiver can take to reconnect.
RECONNECT_GRACE_SECONDS=30
# Maximum simultaneous rooms on this server.
MAX_ROOMS=1000

# --- Receiver storage --------------------------------------------------------
# Largest transfer (MB) allowed for browsers without direct-to-disk saving.
MEMORY_FALLBACK_MAX_MB=256

# --- Abuse protection --------------------------------------------------------
MAX_SIGNALING_MESSAGE_BYTES=65536
RATE_LIMIT_BURST=200
RATE_LIMIT_PER_SECOND=30
MAX_CONNECTIONS_PER_IP=50
ROOM_CREATIONS_PER_MINUTE_PER_IP=20
JOINS_PER_MINUTE_PER_IP=60

# --- Operations --------------------------------------------------------------
LOG_LEVEL=info
# Expose aggregate counters at /api/stats (used by the end-to-end test).
STATS_ENABLED=false
